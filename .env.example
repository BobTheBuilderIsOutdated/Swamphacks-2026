# Copy to .env locally. Never commit real values.
PORT=3000
APP_URL=http://localhost:3000
# Auth0 SPA application and custom API identifier
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://nudge-api
# Separate Auth0 Native application for Chrome PKCE
AUTH0_EXTENSION_CLIENT_ID=
# Comma-separated chrome-extension://... origins for your sideloaded extension
EXTENSION_ORIGINS=
# Production requires PostgreSQL; local development defaults to on-disk PGlite.
DATABASE_URL=
# Exactly 32 random bytes encoded as base64; generate with npm instructions.
DATA_ENCRYPTION_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set true only after verifying test mailbox send/read behavior.
EMAIL_SENDING_ENABLED=false
# One durable server runs periodic work. Vercel needs an external scheduler.
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=60
CRON_SECRET=
