{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "{server/schema.sql,node_modules/@napi-rs/canvas*/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs}",
      "excludeFiles": "{data/**,pages-dist/**,node_modules/@electric-sql/pglite/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/auth/callback", "destination": "/index.html" }
  ]
}
