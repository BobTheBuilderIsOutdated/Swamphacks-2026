{
  "name": "nudge-outreach",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "npm run build && node --env-file-if-exists=.env --watch server/index.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "2.28.4",
    "@electric-sql/pglite": "0.5.10",
    "archiver": "8.0.0",
    "cheerio": "1.2.0",
    "esbuild": "0.28.2",
    "express": "5.3.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "mammoth": "1.13.0",
    "multer": "2.4.0",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "robots-parser": "3.0.1",
    "undici": "8.12.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "supertest": "7.3.1"
  }
}
